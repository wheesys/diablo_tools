{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diablo Tools",
  "version": "0.1.0",
  "identifier": "com.diablo-tools.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Diablo Tools - D2R Save Editor",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "copyright": "Copyright 2025 zl",
    "category": "Game",
    "shortDescription": "Diablo 2 Resurrected Save Editor",
    "longDescription": "A cross-platform save editor for Diablo 2: Resurrected",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {}
}
